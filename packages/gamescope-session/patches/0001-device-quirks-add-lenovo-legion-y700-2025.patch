@@ -213,6 +213,12 @@
   export STEAM_DISPLAY_REFRESH_LIMITS=60,144
 fi
 
+if [[ ":Lenovo Legion Y700 (2025) / TB321FU:" =~ ":$SYS_ID:" ]]; then
