From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Thu, 12 Nov 2026 07:10:04 +0900
Subject: [PATCH] ASoC: qcom: sc8280xp: Add Lenovo Legion Y700 (2025) sound
 card

The TB321FU speaker amplifiers sit on secondary TDM with the DSP as
clock provider and no data delay after the frame sync. Add its card
data with DSP_B for the codecs and the TDM bit clock enabled. It keeps
the sm8650 driver name, so topology and UCM paths stay under sm8650.

Signed-off-by: seilent <github@seilent.net>
---
 sound/soc/qcom/sc8280xp.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index e136407c5..928ae1579 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -593,6 +593,16 @@ static const struct qcom_snd_soc_common kaanapali_priv_data = {
 	.wcd_jack = true,
 };
 
+static const struct qcom_snd_soc_common lenovo_tb321fu_priv_data = {
+	.driver_name = "sm8650",
+	.dapm_widgets = sc8280xp_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(sc8280xp_dapm_widgets),
+	.mi2s_bclk_enable = true,
+	.codec_dai_fmt = SND_SOC_DAIFMT_BC_FC |
+			 SND_SOC_DAIFMT_NB_NF |
+			 SND_SOC_DAIFMT_DSP_B,
+};
+
 static const struct qcom_snd_soc_common maili_priv_data = {
 	.driver_name = "maili",
 	.dapm_widgets = sc8280xp_dapm_widgets,
@@ -732,6 +742,7 @@ static const struct qcom_snd_soc_common sm8750_priv_data = {
 
 static const struct of_device_id snd_sc8280xp_dt_match[] = {
 	{ .compatible = "ayaneo,pocket-s2-sndcard", .data = &ayaneo_ps2_priv_data },
+	{ .compatible = "lenovo,tb321fu-sndcard", .data = &lenovo_tb321fu_priv_data },
 	{ .compatible = "qcom,eliza-sndcard", .data = &eliza_priv_data },
 	{ .compatible = "qcom,hawi-sndcard", .data = &hawi_priv_data },
 	{ .compatible = "qcom,kaanapali-sndcard", .data = &kaanapali_priv_data },
-- 
