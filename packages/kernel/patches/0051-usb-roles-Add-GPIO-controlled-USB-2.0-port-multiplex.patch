From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Fri, 13 Nov 2026 00:04:53 +0900
Subject: [PATCH] usb: roles: Add GPIO controlled USB 2.0 port multiplexer
 driver

Add a driver for a 2:1 switch that connects the USB 2.0 data lines of
one of two connectors to a single USB controller. Each input registers
a USB role switch that the connector's Type-C driver sets. The first
input with a data role gets the lines, input 0 when both have one, and
the controller's role switch takes the role of that input. With no data
role on either input the lines stay where they are and the controller
stays in device mode, so a gadget keeps working on whichever connector
gets a host next. The select line is left as the bootloader set it
until the first switch, and the controller role only drops to none
while the lines move.

Signed-off-by: seilent <github@seilent.net>
---
 MAINTAINERS                            |   1 +
 drivers/usb/roles/Kconfig              |  12 ++
 drivers/usb/roles/Makefile             |   1 +
 drivers/usb/roles/gpio-usb2-port-mux.c | 203 +++++++++++++++++++++++++
 4 files changed, 217 insertions(+)
 create mode 100644 drivers/usb/roles/gpio-usb2-port-mux.c

diff --git a/MAINTAINERS b/MAINTAINERS
index 150e79686..721e9fa59 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -11549,6 +11549,7 @@ M:	seilent <github@seilent.net>
 L:	linux-usb@vger.kernel.org
 S:	Maintained
 F:	Documentation/devicetree/bindings/usb/gpio-usb2-port-mux.yaml
+F:	drivers/usb/roles/gpio-usb2-port-mux.c
 
 GRETH 10/100/1G Ethernet MAC device driver
 M:	Andreas Larsson <andreas@gaisler.com>
diff --git a/drivers/usb/roles/Kconfig b/drivers/usb/roles/Kconfig
index f8b31aa67..f4e0de1e7 100644
--- a/drivers/usb/roles/Kconfig
+++ b/drivers/usb/roles/Kconfig
@@ -26,4 +26,16 @@ config USB_ROLES_INTEL_XHCI
 	  To compile the driver as a module, choose M here: the module will
 	  be called intel-xhci-usb-role-switch.
 
+config USB_ROLES_GPIO_USB2_PORT_MUX
+	tristate "GPIO controlled USB 2.0 port multiplexer"
+	depends on GPIOLIB && OF
+	help
+	  Driver for a GPIO controlled 2:1 switch that connects the USB 2.0
+	  data lines of one of two connectors to a single USB controller. The
+	  switch follows the data roles the connectors report and passes the
+	  role of the selected connector to the controller.
+
+	  To compile the driver as a module, choose M here: the module will
+	  be called gpio-usb2-port-mux.
+
 endif # USB_ROLE_SWITCH
diff --git a/drivers/usb/roles/Makefile b/drivers/usb/roles/Makefile
index 757a7d279..ef7cff64e 100644
--- a/drivers/usb/roles/Makefile
+++ b/drivers/usb/roles/Makefile
@@ -3,3 +3,4 @@
 obj-$(CONFIG_USB_ROLE_SWITCH)		+= roles.o
 roles-y					:= class.o
 obj-$(CONFIG_USB_ROLES_INTEL_XHCI)	+= intel-xhci-usb-role-switch.o
+obj-$(CONFIG_USB_ROLES_GPIO_USB2_PORT_MUX)	+= gpio-usb2-port-mux.o
diff --git a/drivers/usb/roles/gpio-usb2-port-mux.c b/drivers/usb/roles/gpio-usb2-port-mux.c
new file mode 100644
index 000000000..076603db1
--- /dev/null
+++ b/drivers/usb/roles/gpio-usb2-port-mux.c
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/usb/role.h>
+
+#define USB2_PORT_MUX_INPUTS	2
+#define USB2_PORT_MUX_SETTLE_US	10000
+
+struct usb2_port_mux;
+
+struct usb2_port_mux_input {
+	struct usb2_port_mux *mux;
+	struct usb_role_switch *sw;
+	enum usb_role role;
+};
+
+struct usb2_port_mux {
+	struct device *dev;
+	struct gpio_desc *select;
+	struct usb_role_switch *controller;
+	struct usb2_port_mux_input inputs[USB2_PORT_MUX_INPUTS];
+	/* Protects the input roles and the selected input */
+	struct mutex lock;
+	int selected;
+};
+
+static int usb2_port_mux_update(struct usb2_port_mux *mux)
+{
+	enum usb_role role = USB_ROLE_DEVICE;
+	int port = -1;
+	int ret;
+	int i;
+
+	for (i = 0; i < USB2_PORT_MUX_INPUTS; i++) {
+		if (mux->inputs[i].role != USB_ROLE_NONE) {
+			port = i;
+			role = mux->inputs[i].role;
+			break;
+		}
+	}
+
+	if (port >= 0 && port != mux->selected) {
+		int cur = mux->selected;
+
+		if (cur < 0)
+			cur = gpiod_get_value_cansleep(mux->select);
+
+		if (cur != port) {
+			ret = usb_role_switch_set_role(mux->controller,
+						       USB_ROLE_NONE);
+			if (ret)
+				return ret;
+		}
+
+		ret = gpiod_direction_output(mux->select, port);
+		if (ret)
+			return ret;
+
+		mux->selected = port;
+		if (cur != port) {
+			fsleep(USB2_PORT_MUX_SETTLE_US);
+			dev_dbg(mux->dev, "USB 2.0 lines on port %d\n", port);
+		}
+	}
+
+	return usb_role_switch_set_role(mux->controller, role);
+}
+
+static int usb2_port_mux_set(struct usb_role_switch *sw, enum usb_role role)
+{
+	struct usb2_port_mux_input *input = usb_role_switch_get_drvdata(sw);
+	struct usb2_port_mux *mux = input->mux;
+
+	guard(mutex)(&mux->lock);
+
+	input->role = role;
+
+	return usb2_port_mux_update(mux);
+}
+
+static enum usb_role usb2_port_mux_get(struct usb_role_switch *sw)
+{
+	struct usb2_port_mux_input *input = usb_role_switch_get_drvdata(sw);
+
+	guard(mutex)(&input->mux->lock);
+
+	return input->role;
+}
+
+static void usb2_port_mux_put_controller(void *data)
+{
+	usb_role_switch_put(data);
+}
+
+static void usb2_port_mux_unregister(void *data)
+{
+	usb_role_switch_unregister(data);
+}
+
+static int usb2_port_mux_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct usb2_port_mux *mux;
+	int ret;
+
+	mux = devm_kzalloc(dev, sizeof(*mux), GFP_KERNEL);
+	if (!mux)
+		return -ENOMEM;
+
+	mux->dev = dev;
+	mux->selected = -1;
+
+	ret = devm_mutex_init(dev, &mux->lock);
+	if (ret)
+		return ret;
+
+	mux->select = devm_gpiod_get(dev, "select", GPIOD_ASIS);
+	if (IS_ERR(mux->select))
+		return dev_err_probe(dev, PTR_ERR(mux->select),
+				     "failed to get the select GPIO\n");
+
+	mux->controller = usb_role_switch_get(dev);
+	if (IS_ERR(mux->controller))
+		return dev_err_probe(dev, PTR_ERR(mux->controller),
+				     "failed to get the controller role switch\n");
+	if (!mux->controller)
+		return dev_err_probe(dev, -ENODEV,
+				     "no controller role switch on the port\n");
+
+	ret = devm_add_action_or_reset(dev, usb2_port_mux_put_controller,
+				       mux->controller);
+	if (ret)
+		return ret;
+
+	device_for_each_child_node_scoped(dev, child) {
+		struct usb_role_switch_desc desc = { };
+		struct usb2_port_mux_input *input;
+		u32 reg;
+
+		if (!fwnode_name_eq(child, "usb2-port"))
+			continue;
+
+		ret = fwnode_property_read_u32(child, "reg", &reg);
+		if (ret || reg >= USB2_PORT_MUX_INPUTS)
+			return dev_err_probe(dev, -EINVAL,
+					     "invalid reg of %pfwP\n", child);
+
+		input = &mux->inputs[reg];
+		if (input->mux)
+			return dev_err_probe(dev, -EINVAL,
+					     "duplicate input %u\n", reg);
+
+		input->mux = mux;
+		input->role = USB_ROLE_NONE;
+
+		desc.fwnode = child;
+		desc.set = usb2_port_mux_set;
+		desc.get = usb2_port_mux_get;
+		desc.driver_data = input;
+		desc.name = devm_kasprintf(dev, GFP_KERNEL, "%s-port%u",
+					   dev_name(dev), reg);
+		if (!desc.name)
+			return -ENOMEM;
+
+		input->sw = usb_role_switch_register(dev, &desc);
+		if (IS_ERR(input->sw))
+			return dev_err_probe(dev, PTR_ERR(input->sw),
+					     "failed to register input %u\n", reg);
+
+		ret = devm_add_action_or_reset(dev, usb2_port_mux_unregister,
+					       input->sw);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id usb2_port_mux_of_match[] = {
+	{ .compatible = "gpio-usb2-port-mux" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, usb2_port_mux_of_match);
+
+static struct platform_driver usb2_port_mux_driver = {
+	.probe = usb2_port_mux_probe,
+	.driver = {
+		.name = "gpio-usb2-port-mux",
+		.of_match_table = usb2_port_mux_of_match,
+	},
+};
+module_platform_driver(usb2_port_mux_driver);
+
+MODULE_DESCRIPTION("GPIO controlled USB 2.0 port multiplexer");
+MODULE_AUTHOR("seilent <github@seilent.net>");
+MODULE_LICENSE("GPL");
-- 
2.55.0

