From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Thu, 12 Nov 2026 06:02:49 +0900
Subject: [PATCH] dt-bindings: usb: Add Parade PS5169 USB-C redriver

Add the binding for the Parade PS5169, a linear redriver for the
SuperSpeed lanes of a USB-C port with DisplayPort Alt Mode support,
as found on the Lenovo Legion Y700 (2025). It sits between the USB and
DisplayPort combo PHY and the connector and acts as orientation and
retimer switch.

Signed-off-by: seilent <github@seilent.net>
---
 .../bindings/usb/parade,ps5169.yaml           | 94 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 100 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/parade,ps5169.yaml

diff --git a/Documentation/devicetree/bindings/usb/parade,ps5169.yaml b/Documentation/devicetree/bindings/usb/parade,ps5169.yaml
new file mode 100644
index 000000000..49d7a9d90
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/parade,ps5169.yaml
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/parade,ps5169.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Parade PS5169 USB-C DisplayPort Alt Mode linear redriver
+
+maintainers:
+  - seilent <github@seilent.net>
+
+description:
+  The Parade PS5169 is a linear redriver for the SuperSpeed lanes of a USB-C
+  port. It carries USB 3, DisplayPort or both on the connector lanes, follows
+  the plug orientation and monitors the DisplayPort AUX channel.
+
+properties:
+  compatible:
+    const: parade,ps5169
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: power supply (1.8V)
+
+  orientation-switch: true
+  retimer-switch: true
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Super Speed (SS) Output endpoint to the Type-C connector
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Super Speed (SS) Input endpoint from the Super-Speed PHY
+
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - orientation-switch
+  - retimer-switch
+
+allOf:
+  - $ref: usb-switch.yaml#
+  - $ref: usb-switch-ports.yaml#
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        typec-mux@30 {
+            compatible = "parade,ps5169";
+            reg = <0x30>;
+
+            vdd-supply = <&vreg_l15b_1p8>;
+
+            orientation-switch;
+            retimer-switch;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+
+                    redriver_ss_out: endpoint {
+                        remote-endpoint = <&usb_con_ss>;
+                    };
+                };
+
+                port@1 {
+                    reg = <1>;
+
+                    redriver_ss_in: endpoint {
+                        remote-endpoint = <&usb_phy_ss>;
+                    };
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 19a7fa9eb..7c7e1c744 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -21274,6 +21274,12 @@ L:	platform-driver-x86@vger.kernel.org
 S:	Maintained
 F:	drivers/platform/x86/panasonic-laptop.c
 
