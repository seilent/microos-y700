From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Thu, 12 Nov 2026 01:36:28 +0900
Subject: [PATCH] dt-bindings: input: touchscreen: Add Novatek NT36523 SPI
 touchscreen

Add the binding for the touchscreen and pen part of the Novatek NT36523
display driver IC, as found on the Lenovo Legion Y700 (2025). The
controller has no flash and the host loads its firmware over SPI each
time the panel powers on, so the node refers to its panel.

Signed-off-by: seilent <github@seilent.net>
---
 .../input/touchscreen/novatek,nt36523-ts.yaml | 77 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 83 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523-ts.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523-ts.yaml b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523-ts.yaml
new file mode 100644
index 000000000..879e636c4
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523-ts.yaml
@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/novatek,nt36523-ts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36523 SPI touchscreen and pen controller
+
+maintainers:
+  - seilent <github@seilent.net>
+
+description:
+  The touch and pen part of the Novatek NT36523 display driver IC. It has no
+  flash; the host loads its firmware over SPI each time the panel powers on,
+  so the node refers to the panel it is part of.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: novatek,nt36523-ts
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  firmware-name:
+    maxItems: 1
+
+  panel:
+    description:
+      The display panel the controller is part of. The firmware is loaded
+      each time this panel is prepared.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - firmware-name
+  - panel
+  - touchscreen-size-x
+  - touchscreen-size-y
+  - touchscreen-x-mm
+  - touchscreen-y-mm
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "novatek,nt36523-ts";
+            reg = <0>;
+            interrupts-extended = <&tlmm 162 IRQ_TYPE_EDGE_RISING>;
+            reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
+            spi-max-frequency = <9600000>;
+            firmware-name = "novatek_ts_fw.bin";
+            panel = <&panel>;
+            touchscreen-size-x = <16000>;
+            touchscreen-size-y = <25600>;
+            touchscreen-x-mm = <118>;
+            touchscreen-y-mm = <190>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 222b7fc2c..788d06ba2 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
