From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Fri, 13 Nov 2026 00:04:53 +0900
Subject: [PATCH] dt-bindings: usb: Add GPIO controlled USB 2.0 port
 multiplexer

Some boards route the USB 2.0 data lines of two USB-C connectors to one
controller through a 2:1 analog switch with a GPIO select line, as the
Lenovo Legion Y700 (2025) does. Describe the switch with one input per
connector, each a USB role switch, and the controller on its own port.

Signed-off-by: seilent <github@seilent.net>
---
 .../bindings/usb/gpio-usb2-port-mux.yaml      | 107 ++++++++++++++++++
 MAINTAINERS                                   |   6 +
 2 files changed, 113 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/gpio-usb2-port-mux.yaml

diff --git a/Documentation/devicetree/bindings/usb/gpio-usb2-port-mux.yaml b/Documentation/devicetree/bindings/usb/gpio-usb2-port-mux.yaml
new file mode 100644
index 000000000..9caf0badc
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/gpio-usb2-port-mux.yaml
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/gpio-usb2-port-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GPIO controlled USB 2.0 port multiplexer
+
+maintainers:
+  - seilent <github@seilent.net>
+
+description:
+  A 2:1 analog switch connects the USB 2.0 data lines of one of two connectors
+  to a single USB controller, selected by a GPIO. Each input is a USB role
+  switch for its connector. The first input with a data role gets the lines,
+  input 0 when both have one, and the controller takes that role.
+
+properties:
+  compatible:
+    const: gpio-usb2-port-mux
+
+  select-gpios:
+    description: Selects input 0 when inactive and input 1 when active.
+    maxItems: 1
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: USB 2.0 endpoint of the USB controller
+
+patternProperties:
+  '^usb2-port@[01]$':
+    type: object
+    additionalProperties: false
+    description: Input of the multiplexer, wired to a connector
+
+    properties:
+      reg:
+        maxItems: 1
+
+      usb-role-switch:
+        $ref: /schemas/types.yaml#/definitions/flag
+
+      port:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: USB 2.0 endpoint of the connector
+
+    required:
+      - reg
+      - usb-role-switch
+      - port
+
+required:
+  - compatible
+  - select-gpios
+  - '#address-cells'
+  - '#size-cells'
+  - port
+  - usb2-port@0
+  - usb2-port@1
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    usb2-port-mux {
+        compatible = "gpio-usb2-port-mux";
+        select-gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        port {
+            endpoint {
+                remote-endpoint = <&usb_1_dwc3_hs>;
+            };
+        };
+
+        usb2-port@0 {
+            reg = <0>;
+            usb-role-switch;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&connector0_hs>;
+                };
+            };
+        };
+
+        usb2-port@1 {
+            reg = <1>;
+            usb-role-switch;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&connector1_hs>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
