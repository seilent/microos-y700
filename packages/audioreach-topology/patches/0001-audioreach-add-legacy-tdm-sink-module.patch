+define(`SG_INDEX', 1) dnl
+define(`CONTAINER_INDEX', 1) dnl
+define(`MOD_INDEX', 1) dnl
+define(`DEVICE_PLAYBACK_ROUTE',
+`'
+`SectionGraph."NAME_PREFIX.$1 $3 Graph" {'
+`        index STR($1)'
+`        lines ['
+`                "NAME_PREFIX.mfc$1, , $3 Audio Mixer"'
+`                "NAME_PREFIX.tdm_rx$1, , NAME_PREFIX.mfc$1"'
+`                "$2 Playback, , NAME_PREFIX.tdm_rx$1"'
+`        ]'
+`}')
+
+AR_SUBGRAPH(SG_INDEX, DEVICE_DAI_ID, SG_IID_START, DEVICE_PERF_MODE, DEVICE_DIRECTION, CONT_SENARIO_ID)
+AR_CONTAINER(CONTAINER_INDEX, CONT_IID_START, CONT_CAP, CONT_STACK_SIZE, CONT_POSITION, DEVICE_DOMAIN_ID)
+AR_MODULE_MFC(MOD_INDEX, SG_INDEX, CONTAINER_INDEX, MFC_MODULE_IID, 1, 1, 2, 1, 1, 2, TDM_MODULE_IID)
+AR_MODULE_TDM_RX(MOD_INDEX, SG_INDEX, CONTAINER_INDEX, TDM_MODULE_IID, 1, 0, 2, 0, 1, 0, DEVICE_INTF_TYPE, DEVICE_INTF_INDEX, DEVICE_DATA_FORMAT, DEVICE_TDM_NSLOTS_PER_FRAME, DEVICE_TDM_SLOT_WIDTH, `DEVICE_NAME', NONE_IID, DEVICE_TDM_SYNC_SRC, DEVICE_TDM_DATA_OUT, DEVICE_TDM_SYNC_MODE, DEVICE_TDM_SYNC_PULSE, DEVICE_TDM_DATA_DELAY)
+DEVICE_PLAYBACK_ROUTE(MOD_INDEX, `DEVICE_NAME', `MIXER_PREFIX')
