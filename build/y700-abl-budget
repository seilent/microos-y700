#!/usr/bin/env python3
import gzip
import struct
import sys

REGION = 0x5600000
OFFSET = 0x80000
DTB_GUARD = 2 * 1024 * 1024


def align(v, a):
    return (v + a - 1) // a * a


def kernel_of(path):
    d = open(path, "rb").read()
    if d[:8] != b"ANDROID!":
        raise SystemExit(f"{path}: not an Android boot image")
    ver = struct.unpack_from("<I", d, 40)[0]
    if ver >= 3:
        ksize, rsize = struct.unpack_from("<II", d, 8)
        page = 4096
    else:
        ksize, rsize = struct.unpack_from("<II", d, 8)[0], struct.unpack_from("<I", d, 16)[0]
        page = struct.unpack_from("<I", d, 36)[0]
    k = d[page:page + ksize]
    if k[:2] == b"\x1f\x8b":
        k = gzip.decompress(k)
    image_size = struct.unpack_from("<Q", k, 16)[0]
    return ver, page, ksize, rsize, image_size


def vendor_ramdisk(path):
    d = open(path, "rb").read()
    if d[:8] != b"VNDRBOOT":
        raise SystemExit(f"{path}: not a vendor_boot image")
    page, _, _, size = struct.unpack_from("<IIII", d, 12)
    return size


def init_boot_ramdisk(path):
    d = open(path, "rb").read()
    if d[:8] != b"ANDROID!":
        raise SystemExit(f"{path}: not a boot image")
    return struct.unpack_from("<I", d, 12)[0]


def main(argv):
    if len(argv) < 2:
        raise SystemExit("usage: y700-abl-budget <boot.img> [vendor_boot.img] [init_boot.img] [extra-ramdisk-bytes]")
    ver, page, ksize, rsize, image_size = kernel_of(argv[1])
    ramdisks = rsize
    if len(argv) > 2 and argv[2] != "-":
        ramdisks += vendor_ramdisk(argv[2])
    if len(argv) > 3 and argv[3] != "-":
        ramdisks += init_boot_ramdisk(argv[3])
    if len(argv) > 4:
        ramdisks += int(argv[4])
    ram = align(ramdisks, page) + page
    budget = REGION - OFFSET - ram - (page + DTB_GUARD)
    margin = budget - image_size
    print(f"header_version {ver}")
    print(f"kernel image_size {image_size}")
    print(f"ramdisks {ramdisks}")
    print(f"budget {budget} (region {REGION} offset {OFFSET}, fallback constants of the ROW ABL)")
    print(f"margin {margin}")
    print("PASS" if margin > 0 else "FAIL")
    return 0 if margin > 0 else 1


sys.exit(main(sys.argv))
