[Unit]
Description=Bluetooth public address of %i from the persist partition
BindsTo=sys-subsystem-bluetooth-devices-%i.device
After=sys-subsystem-bluetooth-devices-%i.device dev-disk-by\x2dpartlabel-persist.device
Wants=dev-disk-by\x2dpartlabel-persist.device

[Service]
Type=oneshot
ExecStart=/usr/libexec/microos/microos-bdaddr %i
