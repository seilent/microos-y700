#!/usr/bin/env python3
import os
import struct
import sys

ME = "microos-stub-pack"
TREE = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))))
STUB = os.path.join(TREE, "usr/lib/microos/stub")
USAGE = f"usage: {ME} [--prefix <stub-preset-free.bin>] [--conf <stub-preset-free.conf>] <Image> <out>"


class Refuse(Exception):
    pass


def payload(conf):
    with open(conf) as f:
        for line in f:
            key, sep, value = line.strip().partition("=")
            if sep and key == "MICROOS_STUB_PAYLOAD":
                return int(value.strip("'\""), 0)
    raise Refuse(f"{conf} has no MICROOS_STUB_PAYLOAD")


def main(argv):
    prefix = os.path.join(STUB, "stub-preset-free.bin")
    conf = os.path.join(STUB, "stub-preset-free.conf")
    while argv and argv[0] in ("--prefix", "--conf") and len(argv) > 1:
        if argv[0] == "--prefix":
            prefix = argv[1]
        else:
            conf = argv[1]
        argv = argv[2:]
    if len(argv) != 2:
        print(USAGE, file=sys.stderr)
        return 2
    image, out = argv
    offset = payload(conf)
    with open(prefix, "rb") as f:
        stub = bytearray(f.read())
    if len(stub) != offset:
        raise Refuse(f"{prefix} is {len(stub)} bytes, MICROOS_STUB_PAYLOAD is {offset}")
    if stub[56:60] != b"ARMd":
        raise Refuse(f"{prefix} has no arm64 Image header")
    with open(image, "rb") as f:
        kernel = f.read()
    if kernel[56:60] != b"ARMd":
        raise Refuse(f"{image} has no arm64 Image header")
    size = struct.unpack_from("<Q", kernel, 16)[0]
    if size == 0:
        raise Refuse(f"{image} header image_size is 0")
    total = size + offset
    struct.pack_into("<Q", stub, 16, total)
    tmp = f"{out}.tmp"
    with open(tmp, "wb") as f:
        f.write(stub)
        f.write(kernel)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, out)
    print(f"{ME}: {out} image_size {total}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Refuse, OSError, ValueError, struct.error) as e:
        print(f"{ME}: {e}", file=sys.stderr)
        sys.exit(1)
