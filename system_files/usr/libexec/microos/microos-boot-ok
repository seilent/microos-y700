#!/usr/bin/env bash
set -euo pipefail

me=microos-boot-ok
die() { echo "$me: $*" >&2; exit 1; }
say() { echo "$me: $*" >&2; }

rundir=${MICROOS_RUNDIR:-/run/microos}
statedir=${MICROOS_STATEDIR:-/var/lib/microos}
esp=${MICROOS_ESP:-/boot/efi}
conf=${MICROOS_BOOT_OK_CONF:-/usr/lib/microos/boot-ok.conf}
slotconf=${MICROOS_SLOT_CONF:-/usr/lib/microos/slot.conf}
stubconf=${MICROOS_STUB_CONF:-/usr/lib/microos/stub.conf}
sdamlib=${MICROOS_SDAM_LIB:-/usr/libexec/microos/microos-sdam}
slot=${MICROOS_SLOT:-/usr/libexec/microos/microos-slot}
cmdline=${MICROOS_CMDLINE:-/proc/cmdline}
bootb=${MICROOS_BOOT_B:-/dev/disk/by-partlabel/boot_b}
devmem=${MICROOS_DEVMEM:-/dev/mem}
membase=${MICROOS_DEVMEM_BASE:-0}
lockwait=${MICROOS_BOOT_OK_LOCK_WAIT:-1800}
udcdir=${MICROOS_UDC:-/sys/class/udc}
netdir=${MICROOS_NET:-/sys/class/net}
drmdir=${MICROOS_DRM:-/sys/class/drm}
inputdir=${MICROOS_INPUT:-/sys/class/input}
pins=$statedir/boot-ok-pins
skip=$statedir/boot-ok-skip

[[ -r $conf ]] || die "missing $conf"
. "$conf"

kround=""
read -ra words < "$cmdline" || true
for w in "${words[@]}"; do
  [[ $w != microos.kround=* ]] || kround=${w#microos.kround=}
done

kchecks=""
if [[ -n $kround ]]; then
  case $kround in
    p0|p1a) kchecks="udc wlan0" ;;
    p1b) kchecks="udc wlan0 dsi" ;;
    p1c|p2a|p2b) kchecks="udc wlan0 dsi touch pen" ;;
    *) die "not confirmed: kround $kround has no checks" ;;
  esac
  allow=" $MICROOS_BOOT_OK_ALLOW "
  for u in microos-usb-console.service NetworkManager-wait-online.service; do
    allow=${allow// $u / }
  done
  MICROOS_BOOT_OK_ALLOW=$allow
  say "kround $kround: checks $kchecks"
fi

write() {
  local f=$1 t
  shift
  t=$(mktemp "$f.XXXXXX")
  if (( $# )); then
    printf '%s\n' "$@" > "$t"
  fi
  chmod 0644 "$t"
  sync "$t"
  mv -fT "$t" "$f"
  sync -f "$f"
}

read_status() {
  status=$(ostree admin status --json) || die "ostree admin status failed"
}

id_of() {
  jq -r "[.deployments[] | select($1) | \"\(.checksum).\(.serial)\"] | first // empty" <<< "$status"
}

pinned() {
  jq -e --arg id "$1" 'any(.deployments[]; .pinned and "\(.checksum).\(.serial)" == $id)' <<< "$status" > /dev/null
}

index_of() {
  jq -r --arg id "$1" '.deployments[] | select("\(.checksum).\(.serial)" == $id) | .index' <<< "$status"
}

if [[ -z $kround && -e $skip ]]; then
  want=$(tr -d '[:space:]' < "$skip")
  rm -f "$skip"
  sync -f "$statedir"
  read_status
  booted=$(id_of .booted)
  if [[ -n $booted && $booted == "$want" ]]; then
    echo "$me: skipped once"
    exit 3
  fi
  echo "$me: boot-ok-skip names '$want', booted $booted, not skipped" >&2
fi

health() {
  local s u bad=""
  s=$(systemctl is-system-running 2> /dev/null) || true
  if [[ $s == degraded ]]; then
    while read -r u _; do
      if [[ -n $u && " $MICROOS_BOOT_OK_ALLOW " != *" $u "* ]]; then
        bad+=" $u"
      fi
    done < <(systemctl list-units --state=failed --plain --no-legend --full 2> /dev/null)
    if [[ -n $bad ]]; then
      why="failed:$bad"
      return 1
    fi
  elif [[ $s != running ]]; then
    why="system ${s:-unknown}"
    return 1
  fi
  for u in $MICROOS_BOOT_OK_ACTIVE; do
    if [[ $(systemctl show -p ConditionResult --value "$u") == yes ]] && ! systemctl is-active --quiet "$u"; then
      why="$u is not active"
      return 1
    fi
  done
  kround_ok
}

bit() {
  local -a w
  local i
  read -ra w < "$1" 2> /dev/null || return 1
  i=$(( ${#w[@]} - 1 - $2 / 64 ))
  (( i >= 0 )) || return 1
  (( (0x${w[i]} >> ($2 % 64)) & 1 ))
}

has_input() {
  local d
  for d in "$inputdir"/input*; do
    bit "$d/properties" 1 && bit "$d/capabilities/$1" "$2" && return 0
  done
  return 1
}

kround_ok() {
  local c f up
  for c in $kchecks; do
    case $c in
      udc)
        up=0
        for f in "$udcdir"/*/state; do
          [[ $(cat "$f" 2> /dev/null) != configured ]] || up=1
        done
        (( up )) || { why="kround $kround: no UDC configured"; return 1; }
        ;;
      wlan0) compgen -G "$netdir/*/wireless" > /dev/null || { why="kround $kround: no wireless interface"; return 1; } ;;
      dsi)
        grep -qx connected "$drmdir"/card*-DSI-1/status 2> /dev/null ||
          { why="kround $kround: no DSI-1 connected"; return 1; }
        ;;
      touch) has_input abs 53 || { why="kround $kround: no touchscreen input device"; return 1; } ;;
      pen) has_input key 320 || { why="kround $kround: no pen input device"; return 1; } ;;
    esac
  done
}

waited=0
until health; do
  (( waited < MICROOS_BOOT_OK_WAIT )) || die "not confirmed: $why after $MICROOS_BOOT_OK_WAIT s"
  sleep "$MICROOS_BOOT_OK_STEP"
  waited=$(( waited + MICROOS_BOOT_OK_STEP ))
done
held=0
while (( held < MICROOS_BOOT_OK_HOLD )); do
  sleep "$MICROOS_BOOT_OK_STEP"
  held=$(( held + MICROOS_BOOT_OK_STEP ))
  health || die "not confirmed: $why after $held s of the hold"
done

read_status
booted=$(id_of .booted)
[[ $booted =~ ^[0-9a-f]{64}\.[0-9]+$ ]] || die "no booted deployment in ostree admin status"
b=$(bootc status --json | jq -r '.status.booted.ostree | "\(.checksum).\(.deploySerial)"') || die "bootc status failed"
[[ $b == "$booted" ]] || die "ostree booted $booted, bootc booted $b"

install -d -m 0755 "$rundir" "$statedir"
if [[ -n $kround ]]; then
  say "kround $kround: $booted not pinned, confirmed state and $pins left as they are"
else
  exec 8> "$rundir/update.lock"
  if ! flock -w "$lockwait" 8; then
    echo "$me: not confirmed: update.lock busy" >&2
    exit 3
  fi

  listed=()
  if [[ -f $pins ]]; then
    while read -r id; do
      [[ -n $id ]] && listed+=("$id")
    done < "$pins"
  fi
  was_listed=0
  for id in "${listed[@]}"; do
    [[ $id != "$booted" ]] || was_listed=1
  done

  read_status
  if ! pinned "$booted"; then
    if (( ! was_listed )); then
      listed+=("$booted")
      write "$pins" "${listed[@]}"
      was_listed=1
    fi
    ostree admin pin booted > /dev/null
  fi

  read_status
  [[ $(id_of .booted) == "$booted" ]] || die "the booted deployment changed to $(id_of .booted)"
  pinned "$booted" || die "$booted is not pinned"

  write "$statedir/confirmed" "$booted"
  rollback=no
  ! jq -e 'any(.deployments[]; (.booted or .staged) | not)' <<< "$status" > /dev/null || rollback=yes
  write "$rundir/deployments" "booted=$booted" confirmed=yes "rollback=$rollback"

  pinset() {
    jq -r '.deployments[] | select(.pinned) | "\(.checksum).\(.serial)"' <<< "$status" | LC_ALL=C sort | paste -sd' '
  }
  ids() {
    jq -r '.deployments[] | "\(.checksum).\(.serial)"' <<< "$status"
  }

  read_status
  target=" "
  for id in $(pinset) "$booted"; do
    [[ $target == *" $id "* ]] && continue
    if [[ $id == "$booted" || " ${listed[*]} " != *" $id "* ]]; then
      target+="$id "
    fi
  done

  fails=0
  while :; do
    read_status
    cur=" $(pinset) "
    op="" id=""
    for x in $(ids); do
      if [[ $target == *" $x "* && $cur != *" $x "* ]]; then
        op=pin id=$x
        break
      fi
    done
    if [[ -z $op ]]; then
      for x in $cur; do
        if [[ $target != *" $x "* ]]; then
          op=unpin id=$x
          break
        fi
      done
    fi
    [[ -n $op ]] || break
    if [[ $op == pin ]]; then
      want=$({ tr ' ' '\n' <<< "$cur"; echo "$id"; } | grep . | LC_ALL=C sort | paste -sd' ')
      if [[ $id == "$booted" ]]; then
        ostree admin pin booted > /dev/null
      else
        ostree admin pin "$(index_of "$id")" > /dev/null
      fi
    else
      want=$(tr ' ' '\n' <<< "$cur" | grep . | grep -Fvx "$id" | LC_ALL=C sort | paste -sd' ' || true)
      ostree admin pin --unpin "$(index_of "$id")" > /dev/null
    fi
    read_status
    if [[ $(pinset) != "$want" ]]; then
      fails=$(( fails + 1 ))
      (( fails < 3 )) || die "deployment indexes kept moving, $pins unchanged"
    fi
  done

  if (( was_listed )); then
    write "$pins" "$booted"
  else
    write "$pins"
  fi
fi
id=""
for w in "${words[@]}"; do
  [[ $w != microos.id=* ]] || id=${w#microos.id=}
done

flash_boot() {
  local magic ver a="" b=""
  if [[ -z $id ]]; then
    say "no microos.id on the cmdline"
    return 1
  fi
  if [[ ! -r $bootb ]]; then
    say "$bootb is not readable"
    return 1
  fi
  magic=$(dd if="$bootb" bs=8 count=1 status=none 2> /dev/null | tr -d '\0') || true
  if [[ $magic != ANDROID! ]]; then
    say "$bootb has no boot image header"
    return 1
  fi
  ver=$(od -An -tu4 -j40 -N4 "$bootb" | tr -d ' ')
  if [[ ! $ver =~ ^[0-2]$ ]]; then
    say "$bootb header version ${ver:-unknown}, cmdline not read"
    return 1
  fi
  IFS= read -r -d '' a < <(dd if="$bootb" bs=32 skip=2 count=16 status=none) || true
  IFS= read -r -d '' b < <(dd if="$bootb" bs=32 skip=19 count=32 status=none) || true
  [[ " $a$b " == *" microos.id=$id "* ]]
}

flash=0
if flash_boot; then
  flash=1
  say "flash boot of $id"
else
  say "RAM boot of ${id:-no microos.id}"
fi

if [[ -n $id ]]; then
  f=$esp/microos/boot-attempts
  if mkdir -p "$esp/microos" && echo "$id 0" > "$f.tmp" && mv -f "$f.tmp" "$f" && sync -f "$f"; then
    say "attempt counter of $id reset"
  else
    say "cannot reset $f"
  fi
fi

disarm() {
  python3 - "$devmem" "$membase" "$MICROOS_STUB_STATUS" "$MICROOS_STUB_DISARM" "$MICROOS_STUB_MAGIC" \
    "$MICROOS_STUB_SIGNATURE" "$MICROOS_STUB_ARMED" "$MICROOS_STUB_RUNNING" "$MICROOS_STUB_STOPPED" \
    "$MICROOS_STUB_REFUSED" "${MICROOS_STUB_WAIT:-5}" << 'EOF'
import mmap
import os
import sys
import time

path = sys.argv[1]
base, status, disarm, magic, sig, armed, running, stopped, refused = (int(a, 0) for a in sys.argv[2:11])
wait = float(sys.argv[11])
lo = (min(status, disarm) - base) // mmap.PAGESIZE * mmap.PAGESIZE
hi = max(status, disarm) + 8 - base
fd = os.open(path, os.O_RDWR | os.O_SYNC)
m = mmap.mmap(fd, hi - lo, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=lo)
w = memoryview(m).cast("I")


def word(a):
    return w[(a - base - lo) // 4]


def state():
    s = word(status)
    return s >> 16, s & 0xFFFF, word(status + 4)


g, st, n = state()
if g != sig or st not in (armed, running, stopped, refused):
    print("absent", hex(word(status)), n)
    sys.exit(0)
if st == refused:
    print("refused", st, n)
    sys.exit(0)
if st != stopped:
    w[(disarm - base - lo) // 4] = magic
    end = time.monotonic() + wait
    while st != stopped and time.monotonic() < end:
        time.sleep(0.1)
        g, st, n = state()
print("stopped" if st == stopped else "running", st, n)
EOF
}

stubdown=0
if [[ -r $stubconf ]]; then
  . "$stubconf"
  if r=$(disarm 2>&1); then
    read -r res st n <<< "$r"
    case $res in
      absent) say "no stub, status word $st"; stubdown=1 ;;
      refused) say "stub CPU_ON was refused, PSCI $n" ;;
      stopped) say "stub stopped at $n s"; stubdown=1 ;;
      *) say "stub still running at $n s after the disarm, it resets at $MICROOS_STUB_DEADLINE s" ;;
    esac
  else
    say "stub words not reachable through $devmem: ${r##*$'\n'}"
  fi
else
  say "missing $stubconf, stub not disarmed"
fi

if (( stubdown )); then
  if [[ -r $sdamlib ]]; then
    . "$sdamlib"
    if sdam_find && sdam_put clear; then
      say "fastboot preset cleared in ${sdam##*/}"
    else
      say "fastboot preset not cleared, no SDAM nvram@7100"
    fi
  else
    say "missing $sdamlib, fastboot preset not cleared"
  fi
else
  say "stub not stopped, fastboot preset kept"
fi

MICROOS_SLOT_WRITE=0
if [[ -r $slotconf ]]; then
  . "$slotconf"
fi
if (( flash )); then
  if [[ $MICROOS_SLOT_WRITE != 1 ]]; then
    say "slot writes are off, boot_b not marked good"
  elif [[ ! -x $slot ]]; then
    say "$slot is missing, boot_b not marked good"
  elif "$slot" mark-good; then
    say "boot_b marked good"
  else
    say "microos-slot mark-good failed"
  fi
fi

write "$rundir/boot-confirmed" "$booted"
echo "$me: confirmed $booted"
