#!/usr/bin/env bash
set -uo pipefail

me=microos-fail
conf=${MICROOS_SLOT_CONF:-/usr/lib/microos/slot.conf}
cmdline=${MICROOS_CMDLINE:-/proc/cmdline}
rundir=${MICROOS_RUNDIR:-/run/microos}
efilog=${MICROOS_EFI_LOG:-/usr/libexec/microos/microos-efi-log}
sdamlib=${MICROOS_SDAM_LIB:-/usr/libexec/microos/microos-sdam}
say() { echo "$me: $*" >&2; }

why=${1:-}
[[ $why == emergency || $why == deadline ]] || { echo "usage: $me emergency|deadline" >&2; exit 2; }

if [[ $why == deadline ]]; then
  if [[ -f $rundir/boot-confirmed ]]; then
    say "boot confirmed, no deadline reboot"
    exit 0
  fi
  say "boot not confirmed: no $rundir/boot-confirmed"
fi

MICROOS_BOOT_TRIES=3
[[ -r $conf ]] && . "$conf"

efi=${MICROOS_EFI:-/boot/efi}
if [[ -z ${MICROOS_EFI:-} ]] && ! mountpoint -q "$efi" && ! timeout 30 mount "$efi"; then
  say "$efi is not mounted, no log and no count"
  efi=""
fi

if [[ -n $efi ]]; then
  MICROOS_EFI=$efi "$efilog" "$why" || say "no $why log on $efi"
  id="" test=""
  read -ra words < "$cmdline" || true
  for w in "${words[@]}"; do
    case $w in
      microos.id=*) id=${w#microos.id=} ;;
      microos.test=*) test=${w#microos.test=} ;;
    esac
  done
  f=$efi/microos/boot-attempts
  fid="" count=0
  [[ -f $f ]] && read -r fid count < "$f"
  [[ $count =~ ^[0-9]+$ ]] || count=0
  [[ -n $id && $fid == "$id" ]] || count=0
  say "${id:-no microos.id}, attempt $count of $MICROOS_BOOT_TRIES"
  if (( count >= MICROOS_BOOT_TRIES )); then
    if [[ -n $test ]]; then
      if [[ -r $sdamlib ]] && . "$sdamlib" && sdam_find && sdam_put preset; then
        say "fastboot preset written in ${sdam##*/}, rebooting into the bootloader"
        sync
        systemctl reboot --reboot-argument=bootloader || systemctl --force reboot --reboot-argument=bootloader
        exit 0
      fi
      say "no fastboot preset, plain reboot"
    else
      say "plain reboot, the ABL retry budget decides"
    fi
  fi
fi

sync
systemctl reboot || systemctl --force reboot
